# 本地开发环境变量模板
# ---------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env（.env 已被 .gitignore 忽略，不会入库）
#   2. 终端加载：set -a && source .env && set +a
#      Windows PowerShell 见 README「快速开始」
#   3. IDEA 请在「运行配置 → Environment variables」填写同名变量
#      VS Code 由 .vscode/launch.json 的 envFile 读取
#
# 本文件只作为模板提交，禁止写入任何真实口令。
# ---------------------------------------------------------------

# 必填：本地 MySQL 口令
DB_PASSWORD=change-me

# 可选：不填则使用 application.yml 中的默认值
# DB_URL=jdbc:mysql://localhost:3306/bj_cms?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
# DB_USERNAME=root
